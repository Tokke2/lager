{
  "name": "tadega-lager",
  "productName": "Tadega Lager",
  "version": "1.0.0",
  "description": "Lager och inventering med QR per enhet – skrivbordsapp med lokal server.",
  "main": "main.js",
  "private": true,
  "author": {
    "name": "Tadega",
    "email": "support@example.se"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "bygg:linux": "electron-builder --linux AppImage deb",
    "bygg:win": "electron-builder --win nsis portable",
    "bygg:mac": "electron-builder --mac dmg zip",
    "bygg:alla": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "se.tadega.lager",
    "productName": "Tadega Lager",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public",
        "to": "public"
      },
      {
        "from": "../app",
        "to": "app"
      },
      {
        "from": "../bin",
        "to": "bin"
      },
      {
        "from": "../brand",
        "to": "brand",
        "filter": [
          "**/*.svg",
          "**/*.png",
          "**/*.ico"
        ]
      },
      {
        "from": "../brand/tryck",
        "to": "brand/tryck",
        "filter": [
          "**/*.svg",
          "**/*.pdf",
          "**/*.png",
          "**/*.ai",
          "**/*.eps",
          "**/*.zip"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "../brand/ikoner/ikon-512.png",
      "synopsis": "Lager och inventering",
      "description": "Tadega Lager – lager och inventering med QR per enhet och arbetsställe."
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../brand/ikoner/ikon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tadega Lager"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "../brand/ikoner/ikon-mac-1024.png",
      "darkModeSupport": true
    }
  }
}
